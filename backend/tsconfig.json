{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@/lib/server/session": ["./src/server/session.ts"],
      "@/lib/supabase/server": ["./src/server/supabase-server.ts"],
      "next/server": ["./shims/next/server.ts"],
      "next/headers": ["./shims/next/headers.ts"],
      "@/*": ["../*"]
    }
  },
  "include": ["src/**/*.ts", "shims/**/*.ts"],
  "exclude": ["node_modules", "../node_modules", "../app", "../components", "../e2e", "../src-tauri", "../packages"]
}
