{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMAIC Desktop",
  "version": "0.1.0",
  "identifier": "com.openmaic.desktop",
  "build": {
    "beforeDevCommand": { "script": "pnpm build && node scripts/copy-static.mjs", "wait": true },
    "beforeBuildCommand": "pnpm build && node scripts/prepare-standalone.mjs",
    "devUrl": "http://127.0.0.1:47823",
    "frontendDist": "../src-tauri/resources/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "s": "server"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign-windows.ps1 %1"
    }
  }
}
