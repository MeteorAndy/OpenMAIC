{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openmaic-desktop",
  "version": "0.1.0",
  "identifier": "com.example.openmaicdesktop",
  "build": {
    "beforeDevCommand": "pnpm build && node scripts/prepare-standalone.mjs",
    "beforeBuildCommand": "pnpm build && node scripts/prepare-standalone.mjs",
    "devUrl": "http://localhost:3456",
    "frontendDist": "../src-tauri/resources/server"
  },
  "app": {
    "windows": [
      { "title": "OpenMAIC Desktop", "width": 1280, "height": 800 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/server/**/*"]
  }
}
